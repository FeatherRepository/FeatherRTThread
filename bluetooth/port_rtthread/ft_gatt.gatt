// FeatherTalk GATT database (btstack compile_gatt input)
// Services: GAP + GATT + DIS(0x180A) + LE Audio (PACS/ASCS) + FT Data custom
//
// 顺序约定: 16-bit UUID 服务在前, 128-bit UUID 服务 (FT Data) 排最后。
// ATT Read By Group Type 响应不允许混用两种 UUID 长度, 混排时发现流程
// 依赖客户端在格式截断后正确续询 —— Windows 对 "128-bit 之后回到
// 16-bit" 的续询实测会丢掉后续服务 (M8.1 PACS/ASCS 被吞的根因)。

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "FeatherTalk"
// GAP Appearance: unknown (0x0000)
CHARACTERISTIC, GAP_APPEARANCE, READ, 00 0A

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// Device Information Service (0x180A), static read-only strings
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_DEVICE_INFORMATION
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_MANUFACTURER_NAME_STRING, READ, "FeatherTalk"
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_MODEL_NUMBER_STRING, READ, "Edgi-Talk E84"
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SERIAL_NUMBER_STRING, READ, "9CC7D3E1B931"
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_FIRMWARE_REVISION_STRING, READ, "ft-bk-0.2.0"

// M8.1 LE Audio Unicast Server (BAP): PACS + ASCS (sink-only, 2 sink ASEs)
// - Sink PAC: 1 record, LC3 (0x06): 48 kHz only, 10 ms only,
//   30..120 octets/frame。注意: 特征值必须 ≤ 22B (默认 ATT_MTU 23),
//   手机部分栈 (实测小米) 不做 MTU 交换也不做 Read Blob 续读, 超长
//   PAC 被截断后解析失败 -> 直接断链 (实测根因)。故省略 Channel_Count
//   与 Max_Frames_Per_SDU 两个可选 LTV (声道数经 Codec Config 的
//   Channel Allocation LTV 逐 ASE 告知)
// - Sink ASE x2: dynamic state (idle at boot), notify on every state change
// - ASE Control Point: BAP opcode dispatch (Codec Config/QoS/Enable/...)
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_PUBLISHED_AUDIO_CAPABILITIES_SERVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SINK_PAC, READ, 01 06 00 00 00 00 0C 02 01 80 02 02 02 05 04 1E 00 78 00 00
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SINK_AUDIO_LOCATIONS, READ, 03 00 00 00
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_AVAILABLE_AUDIO_CONTEXTS, READ, 7F 00 00 00
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SUPPORTED_AUDIO_CONTEXTS, READ, 7F 00 00 00

PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_AUDIO_STREAM_CONTROL_SERVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SINK_ASE, READ | NOTIFY | DYNAMIC,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SINK_ASE, READ | NOTIFY | DYNAMIC,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_ASE_CONTROL_POINT, WRITE_WITHOUT_RESPONSE | DYNAMIC,

// M8.1: Common Audio Service (0x1853, 标记服务, 无特征) + TMAP (0x1855)。
// Windows 11 依此把设备归类为 LE Audio 并创建音频端点 (缺 TMAP/CAS 时
// 只识别为通用 BLE, 设置页无音频连接入口, 实测)
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_COMMON_AUDIO_SERVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_TMAP_ROLE, READ, 02 00

PRIMARY_SERVICE, 00001855-0000-1000-8000-00805f9b34fb
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_TMAP_ROLE, READ, 02 00


// M8.1: VCS 音量控制 (TMAP Unicast Media Handler 必配; 音量变化经
// 跨核 ring 应用到解码输出)
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_VOLUME_CONTROL
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_VOLUME_STATE, READ | NOTIFY | DYNAMIC,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_VOLUME_CONTROL_POINT, WRITE_WITHOUT_RESPONSE | DYNAMIC,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_VOLUME_FLAGS, READ, 00
// FT Data custom service (128-bit UUID, 必须最后): phone <-> device
//  - CMD  (write): phone -> device command channel
//  - NTF  (notify): device -> phone status channel
PRIMARY_SERVICE, 46540001-4654-4541-4C4B-000000000001
CHARACTERISTIC,  46540002-4654-4541-4C4B-000000000002, READ | WRITE | DYNAMIC,
CHARACTERISTIC,  46540003-4654-4541-4C4B-000000000003, READ | NOTIFY | DYNAMIC,
