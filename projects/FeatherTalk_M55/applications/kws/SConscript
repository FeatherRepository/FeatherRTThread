# KWS 唤醒词模块（小麦项目 R0）
#
# 说明：Edge Impulse SDK 复用 Edgi_Talk_M55_XiaoZhi 工程已归档的副本
#       （../../Edgi_Talk_M55_XiaoZhi/edge-impulse），不重复占用 27MB 仓库空间。
#       若将来 XiaoZhi 示例工程被移除，把该目录 cp -r 到本工程即可解耦。
#
# 模型：edge-impulse/tflite-model/tflite_learn_333519_3.h —— 现为本地自训的
#       「小麦小麦」v9（标签 noice/xiaomai，arena 32768，resolver 10 算子）。
#       替换模型时需同步 model_metadata.h 的 ARENA_SIZE、model_variables.h 的类别、
#       tflite-resolver.h 的算子表，以及 kws.h 的 KWS_WAKE_WORD_LABEL="xiaomai"。
#       训练/导出链与集成清单见归档仓 local_ai/training/out/INTEGRATION.md。

from building import *
import os

cwd = GetCurrentDir()

# Edge Impulse SDK（复用 Edgi_Talk_M55_XiaoZhi 工程内已归档的副本；
# 模型文件直接替换该副本，构建缓存可复用，避免全量重编）
EI_ROOT = os.path.normpath(os.path.join(cwd, '..', '..', '..', 'Edgi_Talk_M55_XiaoZhi', 'edge-impulse'))
EI_SDK = EI_ROOT + '/edge-impulse-sdk'

if not os.path.isdir(EI_SDK):
    print('[kws] 错误: 找不到 Edge Impulse SDK: ' + EI_SDK)
    print('[kws] 请确认 Edgi_Talk_M55_XiaoZhi 工程存在，或把其 edge-impulse/ 拷到本工程')
    Return('')

# ---------------- 包含路径 ----------------
path = [cwd]                                    # kws.h
# applications/：ipc/feathertalk_ipc.h、led_indicator.h、feathertalk_audio.h
# （父 group 的 CPPPATH 继承可达，这里显式声明依赖，防结构调整后静默失败）
path += [os.path.normpath(os.path.join(cwd, '..'))]
path += [EI_ROOT, EI_ROOT + '/model-parameters', EI_ROOT + '/tflite-model']

path += [EI_SDK]
path += [EI_SDK + '/classifier']
path += [EI_SDK + '/dsp']
# 注意：不要把 kissfft 加进全局路径（与 opus 的 kiss_fft 冲突，EI 内部用相对包含）
path += [EI_SDK + '/porting']

# TensorFlow Lite Micro
path += [EI_SDK + '/tensorflow']
path += [EI_SDK + '/tensorflow/lite']
path += [EI_SDK + '/tensorflow/lite/micro']
path += [EI_SDK + '/tensorflow/lite/kernels']
path += [EI_SDK + '/tensorflow/lite/kernels/internal']
path += [EI_SDK + '/tensorflow/lite/c']
path += [EI_SDK + '/tensorflow/lite/core']
path += [EI_SDK + '/tensorflow/lite/core/c']
path += [EI_SDK + '/tensorflow/core/api']

# 第三方
path += [EI_SDK + '/third_party/flatbuffers/include']
path += [EI_SDK + '/third_party/gemmlowp']
path += [EI_SDK + '/third_party/ruy']

# CMSIS（EI 自带副本；本工程的 Infineon_cmsis-latest 只提供 Core 头，不编源码，无符号冲突）
path += [EI_SDK + '/CMSIS/Core/Include']
path += [EI_SDK + '/CMSIS/DSP/Include']
path += [EI_SDK + '/CMSIS/DSP/PrivateInclude']
path += [EI_SDK + '/CMSIS/NN/Include']

# ---------------- 源文件 ----------------
src = []
src += Glob('*.cpp')
src += Glob('tflite-model/*.cpp') if os.path.isdir(EI_ROOT + '/tflite-model') else []

# RT-Thread 移植层
src += Glob(EI_SDK + '/porting/rtthread/*.cpp')

# DSP
src += Glob(EI_SDK + '/dsp/*.cpp')
src += Glob(EI_SDK + '/dsp/dct/*.cpp')
src += Glob(EI_SDK + '/dsp/kissfft/*.cpp')
src += Glob(EI_SDK + '/dsp/speechpy/*.cpp')
src += Glob(EI_SDK + '/dsp/spectral/*.cpp')
src += Glob(EI_SDK + '/dsp/dsp_engines/*.cpp')

# TFLM core
src += Glob(EI_SDK + '/tensorflow/lite/micro/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/micro/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/micro/memory_planner/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/micro/memory_planner/*.cc')

# TFLM kernels / core
src += Glob(EI_SDK + '/tensorflow/lite/micro/kernels/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/micro/kernels/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/kernels/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/kernels/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/kernels/internal/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/kernels/internal/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/c/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/c/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/c/*.c')
src += Glob(EI_SDK + '/tensorflow/lite/core/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/core/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/core/c/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/core/c/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/core/c/*.c')
src += Glob(EI_SDK + '/tensorflow/lite/core/api/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/core/api/*.cc')
src += Glob(EI_SDK + '/tensorflow/lite/schema/*.cpp')
src += Glob(EI_SDK + '/tensorflow/lite/schema/*.cc')

# CMSIS-NN / DSP（与 XiaoZhi 已验证配置一致）
for sub in ['ActivationFunctions', 'BasicMathFunctions', 'ConcatenationFunctions',
            'ConvolutionFunctions', 'FullyConnectedFunctions', 'NNSupportFunctions',
            'PoolingFunctions', 'ReshapeFunctions', 'SoftmaxFunctions',
            'SVDFunctions', 'LSTMFunctions']:
    src += Glob(EI_SDK + '/CMSIS/NN/Source/' + sub + '/*.c')

for sub in ['TransformFunctions', 'CommonTables', 'BasicMathFunctions',
            'FastMathFunctions', 'StatisticsFunctions', 'SupportFunctions',
            'MatrixFunctions', 'ComplexMathFunctions']:
    src += Glob(EI_SDK + '/CMSIS/DSP/Source/' + sub + '/*.c')

# 排除测试/桩文件
SrcRemove(src, ['*test*.cpp', '*test*.cc', '*mock*.cpp', '*mock*.cc', '*_test.cpp', '*_test.cc'])
SrcRemove(src, ['*test_helper*.cpp', '*fake_micro*.cpp', '*recording_*.cpp'])
# rfft2d 需要浮点 kiss_fft，与 FIXED_POINT 冲突（opus 场景）
SrcRemove(src, [EI_SDK + '/tensorflow/lite/micro/kernels/rfft2d.cpp'])

# ---------------- 编译选项 ----------------
LOCAL_CFLAGS = ' -D__RTTHREAD__ -DEI_PORTING_RTTHREAD=1'
LOCAL_CFLAGS += ' -DTF_LITE_STATIC_MEMORY -DTF_LITE_DISABLE_X86_NEON'
LOCAL_CFLAGS += ' -DEI_CLASSIFIER_TFLITE_ENABLE_CMSIS_NN=1'
LOCAL_CFLAGS += ' -DEIDSP_USE_CMSIS_DSP=1 -DEIDSP_LOAD_CMSIS_DSP_SOURCES=1'
LOCAL_CFLAGS += ' -DEIDSP_QUANTIZE_FILTERBANK=0'
LOCAL_CFLAGS += ' -DARM_MATH_CM55 -DARM_MATH_DSP -DARM_MATH_LOOPUNROLL -DARM_MATH_AUTOVECTORIZE'

LOCAL_CXXFLAGS = LOCAL_CFLAGS
LOCAL_CXXFLAGS += ' -std=c++17 -fno-rtti -fno-exceptions -fno-threadsafe-statics'
LOCAL_CXXFLAGS += ' -Wno-sign-compare -Wno-strict-aliasing'
# -Wno-strict-aliasing 只消警告，不改代码生成。ei::numpy::log 用 *(int32_t*)&a
# 型双关取指数（NVIDIA 快速 log），在 -O2 下按严格别名规则被优化掉尾数多项式，
# 板上实测返回 i*(1+ln2)。必须真给 -fno-strict-aliasing 才改代码生成。
LOCAL_CXXFLAGS += ' -fno-strict-aliasing'

group = DefineGroup('kws', src, depend=[''], CPPPATH=path,
                    LOCAL_CFLAGS=LOCAL_CFLAGS,
                    LOCAL_CXXFLAGS=LOCAL_CXXFLAGS,
                    LIBS=['stdc++', 'supc++'])

Return('group')
